# Copy this file to ".env" and adjust values if needed.

# Port the backend server listens on.
PORT=3000

# Where the SQLite database file is stored.
# Use a relative path (resolved from the backend folder) or an absolute path.
DATABASE_PATH=./data/tasks.db

# Optional Gmail / SMTP configuration for sending task agendas directly:
# Generate a 16-character Google App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional custom SMTP configuration (if not using Gmail service)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
